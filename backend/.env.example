SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# Leave DATABASE_URL unset to use the default local sqlite file at
# backend/instance/kdcce.db (an absolute path, resolved by app/config.py
# regardless of the process's working directory). Set it to a real
# Postgres URL for a deployed environment instead, e.g.:
# DATABASE_URL=postgresql://user:pass@host:5432/kdcce
CORS_ORIGINS=http://localhost:5173
FLASK_APP=wsgi.py

# Optional — the AI assistant (Phase 9) works fully without any of these
# set: every AI-touching feature falls back to a deterministic, template-
# based response when AI_ENABLED is not "true" or no provider key is
# present. Set all three (plus the provider's own API key, e.g.
# ANTHROPIC_API_KEY, read directly from the environment by the provider
# at call time — never put it in this file's tracked example) to turn on
# real narrative summaries.
# AI_ENABLED=true
# AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-4-5
