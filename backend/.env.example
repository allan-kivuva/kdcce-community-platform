SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# Leave DATABASE_URL unset to use the default local sqlite file at
# backend/instance/kdcce.db (an absolute path, resolved by app/config.py
# regardless of the process's working directory). Set it to a real
# Postgres URL for a deployed environment instead, e.g.:
# DATABASE_URL=postgresql://user:pass@host:5432/kdcce
CORS_ORIGINS=http://localhost:5173
FLASK_APP=wsgi.py
